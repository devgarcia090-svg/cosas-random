# --- Obligatorias ---
# Supabase → Project Settings → Database → Connection string → "Transaction pooler"
DATABASE_URL=postgresql://postgres.xxxx:CONTRASEÑA@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Dirección pública de la web, sin barra final (para el QR y las Wallets)
PUBLIC_URL=https://tarjeta.laoficinadelbarbero.es
# PIN del panel del barbero. Mejor 6 cifras o más.
STAFF_PIN=
# Texto aleatorio largo para firmar la sesión del panel: openssl rand -hex 32
SESSION_SECRET=

# --- Apple Wallet (ver SETUP.md) ---
APPLE_PASS_TYPE_ID=pass.es.laoficinadelbarbero.fidelidad
APPLE_TEAM_ID=
# PEM en base64 (base64 -w0 fichero.pem)
APPLE_CERT=
APPLE_KEY=
APPLE_KEY_PASSPHRASE=
APPLE_WWDR=

# --- Google Wallet (ver SETUP.md) ---
GOOGLE_ISSUER_ID=
# JSON de la cuenta de servicio en base64 (base64 -w0 clave.json)
GOOGLE_SERVICE_ACCOUNT=
