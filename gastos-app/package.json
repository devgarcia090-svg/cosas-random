{
  "name": "gastos-app",
  "private": true,
  "version": "1.0.0",
  "description": "Registro de gastos desde Atajos de Apple (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute gastos --local --file=./schema.sql",
    "db:remoto": "wrangler d1 execute gastos --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
