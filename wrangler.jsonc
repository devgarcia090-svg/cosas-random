{
  // Configuración del Worker que sirve mayarottweiler.com
  //
  // IMPORTANTE: "name" tiene que coincidir EXACTAMENTE con el nombre del
  // Worker en el panel de Cloudflare (Workers & Pages -> lo verás en la
  // lista). Si no coincide, la build falla y te avisa; la web NO se rompe.
  "name": "mayarottweiler",

  "compatibility_date": "2026-10-16",

  // Sin esto, wrangler llama a /memberships para averiguar que cuenta
  // usar, y un token creado con la plantilla "Edit Cloudflare Workers"
  // no tiene permiso para esa llamada: falla con "Authentication
  // failed (code 9106)" aunque el token sea perfectamente valido.
  // No es una credencial: sin token no sirve de nada, y Cloudflare lo
  // documenta como parte normal de este archivo.
  "account_id": "c21d634c54dbb741978cf0efd1135bc8",

  // La web se sirve SOLO desde mayarottweiler.com. Si no se declara,
  // wrangler asume true en cada despliegue y reactiva la direccion
  // .workers.dev, dejando el sitio accesible en dos dominios: justo
  // el contenido duplicado que costo cinco semanas sacar de Google.
  "workers_dev": false,

  // Portón de la tienda. Solo se ejecuta en las rutas listadas en
  // "run_worker_first"; el resto de la web la sirve Cloudflare
  // directamente, sin pasar por este código.
  "main": "src/gate.js",

  // Carpeta con la web. Todo lo que hay dentro se publica tal cual.
  // Los archivos _headers y _redirects viven ahí y Cloudflare los procesa
  // (no se sirven como páginas).
  "assets": {
    "directory": "./sitio-recuperado",
    "binding": "ASSETS",

    // Sin esto el Worker ni se llamaría: Cloudflare serviría el HTML
    // directamente desde los assets y la contraseña no pintaría nada.
    "run_worker_first": [
      "/tienda",
      "/tienda.html",
      "/condiciones-venta",
      "/condiciones-venta.html",
      "/envios-devoluciones",
      "/envios-devoluciones.html",
      "/transparencia",
      "/transparencia.html"
    ]
  }

  // No se define "html_handling" ni "not_found_handling" a propósito:
  // los valores por defecto (html_handling = "auto-trailing-slash") son
  // justo el comportamiento que la web tiene ahora mismo, con /guias
  // sirviendo guias.html y /guias.html redirigiendo a /guias. Tocarlos
  // cambiaría las URLs y tiraría el SEO.
}
