# Copia este fichero a .env, rellénalo y protégelo: chmod 600 .env
# .env está en .gitignore. NUNCA lo commitees.
#
# Genera cada contraseña con:  openssl rand -base64 32

# ── General ───────────────────────────────────────────────────────────────
TZ=Europe/Madrid
PUID=1000
PGID=1000

# ── Dominio y TLS ─────────────────────────────────────────────────────────
# Subdominio bajo el que cuelgan todos los servicios.
# Los nombres quedan así: immich.casa.tudominio.com, jellyfin.casa.tudominio.com
DOMAIN=casa.tudominio.com
ACME_EMAIL=tu@correo.com

# Token de API de Cloudflare con permisos Zone:Read + DNS:Edit sobre la zona.
# Se crea en: My Profile → API Tokens → Create Token → Edit zone DNS
# NO es la "Global API Key".
CLOUDFLARE_API_TOKEN=

# ── Immich ────────────────────────────────────────────────────────────────
# Estos nombres los espera el compose OFICIAL de Immich; no los cambies.
#
# Fija la versión y lee las notas antes de subirla:
# https://github.com/immich-app/immich/releases
IMMICH_VERSION=v1.144.1

# Biblioteca de fotos. Es lo irreemplazable de toda la máquina.
UPLOAD_LOCATION=/srv/media/immich
# Base de datos. Va en el NVMe, nunca en un disco USB.
DB_DATA_LOCATION=/srv/data/immich/postgres

DB_PASSWORD=

# ── Vaultwarden ───────────────────────────────────────────────────────────
# Hash Argon2 del token de administración. Genéralo con:
#   docker run --rm -it vaultwarden/server /vaultwarden hash
# Ojo: en el .env hay que duplicar cada '$' → '$$'
VAULTWARDEN_ADMIN_TOKEN=

# Ponlo a false en cuanto hayas creado tu cuenta, y recrea el contenedor.
VAULTWARDEN_SIGNUPS_ALLOWED=true

# ── Paperless ─────────────────────────────────────────────────────────────
PAPERLESS_SECRET_KEY=
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=

# ── Backups (restic → Backblaze B2) ───────────────────────────────────────
# Crea un bucket privado en B2 y una clave de aplicación con acceso solo a él.
RESTIC_REPOSITORY=b2:nombre-de-tu-bucket:homelab
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# Contraseña de cifrado del repositorio restic.
# ⚠️  Si pierdes esto, los backups son basura irrecuperable.
# Guárdala en Vaultwarden Y en papel fuera de casa.
RESTIC_PASSWORD=

# Opcional: segundo repositorio en un disco local, para la 3ª copia del 3-2-1.
# Déjalo vacío para desactivarlo.
RESTIC_REPOSITORY_LOCAL=

# Política de retención
RESTIC_KEEP_DAILY=7
RESTIC_KEEP_WEEKLY=4
RESTIC_KEEP_MONTHLY=12
