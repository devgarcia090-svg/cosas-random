# Cabeceras para Cloudflare Pages / Netlify.
# Si la web se sirve de otra forma, este fichero simplemente se ignora.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Las imágenes y las fuentes no cambian: se cachean un año.
# Si se sustituye una foto, hay que cambiarle el nombre del fichero.
/img/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Estilos y scripts: una semana.
/css/*
  Cache-Control: public, max-age=604800

/js/*
  Cache-Control: public, max-age=604800
